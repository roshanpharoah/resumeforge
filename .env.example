# ResumeForge environment
# Copy this file to .env, then fill in the values you need.
# Only DATABASE_URL and AUTH_SECRET are required for local development.

# ---------------------------------------------------------------
# Core
# ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumeforge?schema=public"

# Long random string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL, used in share links and QR codes.
APP_URL="http://localhost:3000"

# Set to true to allow the development sign in code in production.
# Leave false in any real deployment.
AUTH_DEV_OTP="false"

# Upload limit in megabytes.
MAX_UPLOAD_MB="12"

# ---------------------------------------------------------------
# Google sign in (optional)
# Redirect URI: ${APP_URL}/api/auth/google/callback
# ---------------------------------------------------------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------
# AI drafting (optional)
# Any OpenAI compatible chat completions endpoint works.
# Without a key, every generator falls back to deterministic rules.
# ---------------------------------------------------------------
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"
# LLM_TIMEOUT_MS="60000"

# ---------------------------------------------------------------
# Email delivery (optional in development)
# Without SMTP, the sign in code is returned by the API and shown
# on the login screen in development.
# ---------------------------------------------------------------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="ResumeForge <no-reply@resumeforge.app>"

# ---------------------------------------------------------------
# S3 compatible storage (optional)
# Without S3, original uploads are stored under .data/uploads.
# ---------------------------------------------------------------
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------
# PDF engine (optional)
# Set one of these when Puppeteer cannot find a Chrome binary.
# DOCX and TXT export work without Chrome.
# ---------------------------------------------------------------
# PUPPETEER_EXECUTABLE_PATH=""
# CHROME_PATH=""
